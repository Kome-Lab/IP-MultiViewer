<Window x:Class="IPMultiViewer.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer Settings"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        Background="#070b10"
        Closing="SettingsWindow_Closing">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#111821" />
      <Setter Property="BorderBrush" Value="#233041" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,4,0,8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#0b1118" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="CaretBrush" Value="#38bdf8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,4,0,8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#0b1118" />
      <Setter Property="BorderBrush" Value="#334155" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#172033" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,4,0,8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#0b1118" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="CaretBrush" Value="#38bdf8" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#0b1118" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Foreground="White" FontSize="17" FontWeight="Bold" Margin="16,0" VerticalAlignment="Center">Settings</TextBlock>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
        <Button x:Name="ImportButton" MinWidth="84" Height="30" Margin="0,0,8,0">Import</Button>
        <Button x:Name="ExportButton" MinWidth="84" Height="30" Margin="0,0,8,0">Export</Button>
        <Button x:Name="SaveButton" MinWidth="84" Height="30" Margin="0,0,8,0">Save</Button>
        <Button x:Name="ReloadButton" MinWidth="84" Height="30">Reload</Button>
      </StackPanel>
      <TextBlock Foreground="#9ca3af" VerticalAlignment="Center">Streams, alert profiles, sync, and layout</TextBlock>
    </DockPanel>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Foreground="#f9fafb" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10">Streams</TextBlock>
          <Border DockPanel.Dock="Bottom" Background="#0b1118" BorderBrush="#233041" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Foreground="#f9fafb" FontWeight="SemiBold" Margin="0,0,0,8">Selected Stream</TextBlock>
              <TextBlock Foreground="#9ca3af" FontSize="12">Name</TextBlock>
              <TextBox x:Name="StreamNameText" />
              <TextBlock Foreground="#9ca3af" FontSize="12">Input URL</TextBlock>
              <TextBox x:Name="StreamUrlText" />
              <TextBlock Foreground="#9ca3af" FontSize="12">Protocol</TextBlock>
              <TextBox x:Name="StreamProtocolText" />
              <TextBlock Foreground="#9ca3af" FontSize="12">Group</TextBlock>
              <TextBox x:Name="StreamGroupText" />
              <TextBlock Foreground="#9ca3af" FontSize="12">Tags</TextBlock>
              <TextBox x:Name="StreamTagsText" />
              <TextBlock Foreground="#9ca3af" FontSize="12">Alert Profile</TextBlock>
              <ComboBox x:Name="StreamAlertProfileCombo" DisplayMemberPath="Name" />
              <CheckBox x:Name="StreamEnabledCheck" Foreground="#e5e7eb" Margin="0,2,0,4">Enabled</CheckBox>
              <CheckBox x:Name="StreamAnalysisCheck" Foreground="#e5e7eb" Margin="0,2,0,4">Analysis</CheckBox>
              <CheckBox x:Name="StreamAudioCheck" Foreground="#e5e7eb" Margin="0,2,0,4">Audio monitor</CheckBox>
              <CheckBox x:Name="StreamAlertMuteCheck" Foreground="#e5e7eb" Margin="0,2,0,10">Mute alert sound</CheckBox>
              <Button x:Name="ApplyStreamButton" Height="32">Apply Stream</Button>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddStreamButton" MinWidth="96" Height="30" Margin="0,0,8,0">Add</Button>
                <Button x:Name="DeleteStreamButton" MinWidth="96" Height="30">Delete</Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <ListBox x:Name="StreamsList" Background="#070b10" BorderBrush="#233041" Foreground="#e5e7eb" DisplayMemberPath="Name" />
        </DockPanel>
      </Border>

      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Panel}" Margin="10,0,0,10">
          <StackPanel>
            <TextBlock Foreground="#f9fafb" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10">Alert Profile Thresholds</TextBlock>
            <TextBlock Foreground="#9ca3af" FontSize="12">Profile</TextBlock>
            <ComboBox x:Name="AlertProfileCombo" DisplayMemberPath="Name" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Foreground="#9ca3af" FontSize="12">Black luma</TextBlock>
                <TextBox x:Name="BlackThresholdText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Dark pixel luma</TextBlock>
                <TextBox x:Name="BlackPixelThresholdText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Dark pixel ratio</TextBlock>
                <TextBox x:Name="BlackPixelRatioText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Black duration sec</TextBlock>
                <TextBox x:Name="MinBlackDurationText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Freeze diff</TextBlock>
                <TextBox x:Name="FreezeDifferenceText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Freeze duration sec</TextBlock>
                <TextBox x:Name="MinFreezeDurationText" />
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Foreground="#9ca3af" FontSize="12">Freeze frames</TextBlock>
                <TextBox x:Name="MinFreezeFramesText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Input timeout sec</TextBlock>
                <TextBox x:Name="InputTimeoutText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Low FPS threshold</TextBlock>
                <TextBox x:Name="LowFpsThresholdText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Low FPS duration sec</TextBlock>
                <TextBox x:Name="MinLowFpsDurationText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Silence dBFS</TextBlock>
                <TextBox x:Name="SilenceThresholdText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Silence duration sec</TextBlock>
                <TextBox x:Name="MinSilenceDurationText" />
                <TextBlock Foreground="#9ca3af" FontSize="12">Clipping count</TextBlock>
                <TextBox x:Name="ClippingCountText" />
              </StackPanel>
            </UniformGrid>
            <Button x:Name="ApplyAlertProfileButton" Height="32" Margin="0,8,0,0">Apply Alert Profile</Button>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel}" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Foreground="#f9fafb" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10">Status</TextBlock>
            <TextBlock x:Name="ConfigPathText" Foreground="#9ca3af" TextWrapping="Wrap" />
            <TextBlock x:Name="AlertSummaryText" Foreground="#e5e7eb" Margin="0,12,0,0" />
            <TextBlock Foreground="#9ca3af" FontSize="12" Margin="0,12,0,0">Server URL</TextBlock>
            <TextBox x:Name="ServerUrlText" />
            <TextBlock Foreground="#9ca3af" FontSize="12">Client Token</TextBlock>
            <PasswordBox x:Name="ClientTokenBox" Height="28" Margin="0,4,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox x:Name="ServerSyncCheck" Foreground="#e5e7eb" VerticalAlignment="Center">Server sync</CheckBox>
              <Button x:Name="ApplyServerButton" MinWidth="72" Height="28" Margin="12,0,0,0">Apply</Button>
            </StackPanel>
            <TextBlock x:Name="ServerSyncStatusText" Foreground="#9ca3af" TextWrapping="Wrap" />
            <TextBlock x:Name="ServerClientSummaryText" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Foreground="#9ca3af" FontSize="12" Margin="0,12,0,0">Layout</TextBlock>
            <ComboBox x:Name="LayoutCombo" DisplayMemberPath="Name" />
            <CheckBox x:Name="GlobalMuteCheck" Foreground="#e5e7eb" Margin="0,4,0,0">Global mute</CheckBox>
            <CheckBox x:Name="AlertSoundCheck" Foreground="#e5e7eb" Margin="0,8,0,0">Alert sound</CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
