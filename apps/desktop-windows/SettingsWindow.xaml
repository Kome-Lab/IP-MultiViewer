<Window x:Class="IPMultiViewer.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer Settings"
        Width="1180"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        Background="#0f1117"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="SettingsWindow_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0f1117" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171b24" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#202634" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#273044" />
    <SolidColorBrush x:Key="BorderBrush" Color="#30384a" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f8fafc" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#b8c0cc" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7f8a9b" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38bdf8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#123247" />
    <SolidColorBrush x:Key="DangerBrush" Color="#f87171" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#162033" Offset="0" />
      <GradientStop Color="#0f1117" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#101620" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#2563eb" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#101620, TargetNullValue=#101620}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#101620" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#2563eb" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#101620, TargetNullValue=#101620}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#101620" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#101620, TargetNullValue=#101620}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#101620, TargetNullValue=#101620}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Margin="12,0,4,0"
                                          TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" />
                        <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade">
                <Border Background="#101620"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#101620" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#101620, TargetNullValue=#101620}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,14,10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#202634, TargetNullValue=#202634}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0ea5e9" />
      <Setter Property="BorderBrush" Value="#38bdf8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3b1d25" />
      <Setter Property="BorderBrush" Value="#7f1d1d" />
      <Setter Property="Foreground" Value="#fecaca" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome"
                    Background="#101620"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#64748b" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="86" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold">Settings</TextBlock>
          <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13">Streams, analysis thresholds, sync, and monitoring layout</TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ImportButton" MinWidth="88" Margin="0,0,8,0">Import</Button>
          <Button x:Name="ExportButton" MinWidth="88" Margin="0,0,8,0">Export</Button>
          <Button x:Name="ReloadButton" MinWidth="88" Margin="0,0,8,0">Reload</Button>
          <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" MinWidth="96">Save</Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}">Streams</TextBlock>
            <TextBlock Style="{StaticResource SectionHint}">Select a source, edit its URL and monitoring behavior, then assign it to a tile on the main view.</TextBlock>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource FieldLabel}">CONFIGURATION</TextBlock>
            <Border Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="AlertSummaryText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="AddStreamButton" Grid.Column="0">Add stream</Button>
              <Button x:Name="DeleteStreamButton" Grid.Column="2" Style="{StaticResource DangerButton}">Delete</Button>
            </Grid>
          </StackPanel>

          <ListBox x:Name="StreamsList" DisplayMemberPath="Name" />
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}">Selected stream</TextBlock>
                  <TextBlock Style="{StaticResource SectionHint}">Connection, grouping, and per-stream monitoring switches.</TextBlock>
                </StackPanel>
                <Button x:Name="ApplyStreamButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="132" VerticalAlignment="Top">Apply stream</Button>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}">NAME</TextBlock>
                  <TextBox x:Name="StreamNameText" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}">PROTOCOL</TextBlock>
                  <TextBox x:Name="StreamProtocolText" />
                  <TextBlock Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             Margin="0,-8,0,12"
                             Text="Use srt-caller or srt-listener, or set ?mode= in the SRT URL." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                  <TextBlock Style="{StaticResource FieldLabel}">INPUT URL</TextBlock>
                  <TextBox x:Name="StreamUrlText" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}">GROUP</TextBlock>
                  <TextBox x:Name="StreamGroupText" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}">TAGS</TextBlock>
                  <TextBox x:Name="StreamTagsText" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}">ALERT PROFILE</TextBlock>
                  <ComboBox x:Name="StreamAlertProfileCombo">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,18,0,0">
                  <CheckBox x:Name="StreamEnabledCheck">Enabled</CheckBox>
                  <CheckBox x:Name="StreamAnalysisCheck">Analysis</CheckBox>
                  <CheckBox x:Name="StreamAudioCheck">Audio monitor</CheckBox>
                  <CheckBox x:Name="StreamAlertMuteCheck">Mute alert sound</CheckBox>
                </WrapPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}">Alert profile thresholds</TextBlock>
                  <TextBlock Style="{StaticResource SectionHint}">Create reusable alert profiles, then assign one per stream without changing stream credentials.</TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource FieldLabel}">PROFILE</TextBlock>
                  <ComboBox x:Name="AlertProfileCombo">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}">PROFILE NAME</TextBlock>
                  <TextBox x:Name="AlertProfileNameText" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Bottom">
                  <Button x:Name="AddAlertProfileButton" MinWidth="84">New</Button>
                  <Button x:Name="DuplicateAlertProfileButton" MinWidth="96">Duplicate</Button>
                  <Button x:Name="DeleteAlertProfileButton" Style="{StaticResource DangerButton}" MinWidth="84" Margin="0">Delete</Button>
                </WrapPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,10">Black / freeze</TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}">BLACK LUMA</TextBlock>
                    <TextBox x:Name="BlackThresholdText" />
                    <TextBlock Style="{StaticResource FieldLabel}">DARK PIXEL LUMA</TextBlock>
                    <TextBox x:Name="BlackPixelThresholdText" />
                    <TextBlock Style="{StaticResource FieldLabel}">DARK PIXEL RATIO</TextBlock>
                    <TextBox x:Name="BlackPixelRatioText" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,10">Motion / FPS</TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}">FREEZE DIFF</TextBlock>
                    <TextBox x:Name="FreezeDifferenceText" />
                    <TextBlock Style="{StaticResource FieldLabel}">FREEZE DURATION SEC</TextBlock>
                    <TextBox x:Name="MinFreezeDurationText" />
                    <TextBlock Style="{StaticResource FieldLabel}">FREEZE FRAMES</TextBlock>
                    <TextBox x:Name="MinFreezeFramesText" />
                    <TextBlock Style="{StaticResource FieldLabel}">INPUT TIMEOUT SEC</TextBlock>
                    <TextBox x:Name="InputTimeoutText" />
                    <TextBlock Style="{StaticResource FieldLabel}">LOW FPS THRESHOLD</TextBlock>
                    <TextBox x:Name="LowFpsThresholdText" />
                    <TextBlock Style="{StaticResource FieldLabel}">LOW FPS DURATION SEC</TextBlock>
                    <TextBox x:Name="MinLowFpsDurationText" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                  <StackPanel>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,10">Audio</TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}">SILENCE DBFS</TextBlock>
                    <TextBox x:Name="SilenceThresholdText" />
                    <TextBlock Style="{StaticResource FieldLabel}">SILENCE DURATION SEC</TextBlock>
                    <TextBox x:Name="MinSilenceDurationText" />
                    <TextBlock Style="{StaticResource FieldLabel}">CLIPPING COUNT</TextBlock>
                    <TextBox x:Name="ClippingCountText" />
                    <Button x:Name="ApplyAlertProfileButton" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0">Apply profile</Button>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}">Sync, layout, and audio</TextBlock>
              <TextBlock Style="{StaticResource SectionHint}">Use local mode first, then enable server sync when multiple clients share streams and alerts.</TextBlock>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}">SERVER URL</TextBlock>
                  <TextBox x:Name="ServerUrlText" />
                  <TextBlock Style="{StaticResource FieldLabel}">CLIENT TOKEN</TextBlock>
                  <PasswordBox x:Name="ClientTokenBox" />
                  <WrapPanel>
                    <CheckBox x:Name="ServerSyncCheck">Server sync</CheckBox>
                    <Button x:Name="ApplyServerButton" MinWidth="96">Apply sync</Button>
                  </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}">LAYOUT</TextBlock>
                  <ComboBox x:Name="LayoutCombo">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <WrapPanel Margin="0,2,0,10">
                    <CheckBox x:Name="GlobalMuteCheck">Global mute</CheckBox>
                    <CheckBox x:Name="AlertSoundCheck">Alert sound</CheckBox>
                  </WrapPanel>
                  <Border Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                      <TextBlock x:Name="ServerSyncStatusText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBlock x:Name="ServerClientSummaryText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
