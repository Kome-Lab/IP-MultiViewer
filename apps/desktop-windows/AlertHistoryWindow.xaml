<Window x:Class="IPMultiViewer.Desktop.AlertHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer Alert History"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="420"
        Background="#070b10"
        Closing="AlertHistoryWindow_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="52" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#0b1118" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left"
                 Foreground="White"
                 FontSize="17"
                 FontWeight="Bold"
                 Margin="16,0"
                 VerticalAlignment="Center">Alert History</TextBlock>
      <TextBlock x:Name="SummaryText"
                 Foreground="#9ca3af"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <ListBox x:Name="AlertHistoryList"
             Grid.Row="1"
             Margin="12"
             Background="#0b1118"
             BorderBrush="#233041"
             Foreground="#e5e7eb">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#233041" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="Bold" Foreground="#fca5a5" />
              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#f9fafb" />
              <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#cbd5e1" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="4" Text="{Binding StartedAt}" Foreground="#9ca3af" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DockPanel Grid.Row="2" Background="#0b1118" LastChildFill="False">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
        <Button x:Name="AcknowledgeAlertButton" MinWidth="100" Height="30" Margin="0,0,8,0">Acknowledge</Button>
        <Button x:Name="SnoozeAlertButton" MinWidth="84" Height="30" Margin="0,0,8,0">Snooze</Button>
        <Button x:Name="ResolveAlertButton" MinWidth="84" Height="30" Margin="0,0,8,0">Resolve</Button>
        <Button x:Name="IgnoreAlertButton" MinWidth="84" Height="30">Ignore</Button>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
