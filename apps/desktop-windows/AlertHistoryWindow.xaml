<Window x:Class="IPMultiViewer.Desktop.AlertHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer Alert History"
        Width="1040"
        Height="640"
        MinWidth="860"
        MinHeight="520"
        Background="#0f1117"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="AlertHistoryWindow_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0f1117" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171b24" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#202634" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#273044" />
    <SolidColorBrush x:Key="BorderBrush" Color="#30384a" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f8fafc" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#b8c0cc" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7f8a9b" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38bdf8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#123247" />
    <SolidColorBrush x:Key="DangerBrush" Color="#f87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#162033" Offset="0" />
      <GradientStop Color="#0f1117" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#202634, TargetNullValue=#202634}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0ea5e9" />
      <Setter Property="BorderBrush" Value="#38bdf8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3b1d25" />
      <Setter Property="BorderBrush" Value="#7f1d1d" />
      <Setter Property="Foreground" Value="#fecaca" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome"
                    Background="#101620"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#64748b" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="86" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold">Alert History</TextBlock>
          <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13">Review, acknowledge, snooze, resolve, or ignore stream alerts</TextBlock>
        </StackPanel>
        <Border Grid.Column="1"
                Background="#101620"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,9"
                MinWidth="180"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold">SUMMARY</TextBlock>
            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="18">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="176" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="SEVERITY" />
          <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="STATUS" />
          <TextBlock Grid.Column="2" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="TYPE" />
          <TextBlock Grid.Column="3" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="MESSAGE" />
          <TextBlock Grid.Column="4" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="STARTED" />
        </Grid>

        <ListBox x:Name="AlertHistoryList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="12,10" MinHeight="50">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="176" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          Background="#321820"
                          BorderBrush="#7f1d1d"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#fecaca" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding StartedAt}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Background="#0d111a" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Text="Select an alert before applying a status action." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AcknowledgeAlertButton" MinWidth="116" Margin="0,0,8,0">Acknowledge</Button>
          <Button x:Name="SnoozeAlertButton" MinWidth="94" Margin="0,0,8,0">Snooze</Button>
          <Button x:Name="ResolveAlertButton" Style="{StaticResource PrimaryButton}" MinWidth="94" Margin="0,0,8,0">Resolve</Button>
          <Button x:Name="IgnoreAlertButton" Style="{StaticResource DangerButton}" MinWidth="94">Ignore</Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
