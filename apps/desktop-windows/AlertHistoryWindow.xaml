<Window x:Class="IPMultiViewer.Desktop.AlertHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer Alert History"
        Width="1320"
        Height="760"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#071019"
        Foreground="#F3F6F8"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="AlertHistoryWindow_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#071019" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#050B11" />
    <SolidColorBrush x:Key="CommandBarBrush" Color="#0A141D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0D1821" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#111D27" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#192A36" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33444F" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#1E2D37" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD2D8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A959E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#00A8F3" />
    <SolidColorBrush x:Key="DangerBrush" Color="#CB171B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D99A12" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#31BF72" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InsetCard" TargetType="Border">
      <Setter Property="Background" Value="#09141D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource InsetCard}">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#111D27, TargetNullValue=#111D27}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.68" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#079CE4" />
      <Setter Property="BorderBrush" Value="#14B4FF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3A151A" />
      <Setter Property="BorderBrush" Value="#8E252A" />
      <Setter Property="Foreground" Value="#FFD6D8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#09141D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="#12698E" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#09141D, TargetNullValue=#09141D}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#09141D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#09141D, TargetNullValue=#09141D}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#09141D, TargetNullValue=#09141D}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                IsHitTestVisible="False"
                                Margin="12,0,34,0"
                                TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
              <Popup AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade">
                <Border Background="#09141D"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#09141D" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#09141D, TargetNullValue=#09141D}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#12384B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome"
                    Background="#09141D"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#12384B" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#526A78" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SeverityBadge" TargetType="Border">
      <Setter Property="Background" Value="#102836" />
      <Setter Property="BorderBrush" Value="#28566D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="warning">
          <Setter Property="Background" Value="#342610" />
          <Setter Property="BorderBrush" Value="#8B6413" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="error">
          <Setter Property="Background" Value="#351418" />
          <Setter Property="BorderBrush" Value="#86242A" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="critical">
          <Setter Property="Background" Value="#451216" />
          <Setter Property="BorderBrush" Value="#CB171B" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
      <Setter Property="Background" Value="#13212A" />
      <Setter Property="BorderBrush" Value="#33444F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="open">
          <Setter Property="Background" Value="#351418" />
          <Setter Property="BorderBrush" Value="#86242A" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="acknowledged">
          <Setter Property="Background" Value="#102B39" />
          <Setter Property="BorderBrush" Value="#14668B" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="snoozed">
          <Setter Property="Background" Value="#342610" />
          <Setter Property="BorderBrush" Value="#8B6413" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="resolved">
          <Setter Property="Background" Value="#102B20" />
          <Setter Property="BorderBrush" Value="#237249" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="82" />
      <RowDefinition Height="78" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource TitleBarBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Text="Alert History" />
          <TextBlock Foreground="{StaticResource TextMutedBrush}"
                     FontSize="12"
                     Text="Investigate current incidents and review historical alert activity" />
        </StackPanel>
        <Border Grid.Column="1"
                MinWidth="190"
                Padding="14,9"
                VerticalAlignment="Center"
                Background="#09141D"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="3">
          <StackPanel>
            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Text="SUMMARY" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{StaticResource CommandBarBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="18,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="ACTIVE" />
            <TextBlock x:Name="ActiveCountText" Foreground="#FF8B90" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="OPEN" />
            <TextBlock x:Name="OpenCountText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="ACKNOWLEDGED" />
            <TextBlock x:Name="AcknowledgedCountText" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="SNOOZED" />
            <TextBlock x:Name="SnoozedCountText" Foreground="#E6B84E" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="0">
          <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="TOTAL" />
            <TextBlock x:Name="TotalCountText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource CommandBarBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="18,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="SearchLabel" Style="{StaticResource FieldLabel}" Text="SEARCH" />
          <TextBox x:Name="SearchTextBox"
                   AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                   AutomationProperties.HelpText="Search stream, type, message, status, or severity" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="StatusFilterLabel" Style="{StaticResource FieldLabel}" Text="STATUS" />
          <ComboBox x:Name="StatusFilterCombo"
                    AutomationProperties.LabeledBy="{Binding ElementName=StatusFilterLabel}" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock x:Name="SeverityFilterLabel" Style="{StaticResource FieldLabel}" Text="SEVERITY" />
          <ComboBox x:Name="SeverityFilterCombo"
                    AutomationProperties.LabeledBy="{Binding ElementName=SeverityFilterLabel}" />
        </StackPanel>
        <Button x:Name="ClearFiltersButton"
                Grid.Column="6"
                MinWidth="92"
                Margin="0,15,0,0"
                VerticalAlignment="Top"
                Content="Clear" />
        <TextBlock x:Name="ResultsSummaryText"
                   Grid.Column="7"
                   Margin="18,15,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="116" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="STREAM" />
            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="SEVERITY" />
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="STATUS" />
            <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="TYPE" />
            <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="MESSAGE" />
            <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="STARTED" />
          </Grid>

          <Grid Grid.Row="1">
            <ListBox x:Name="AlertHistoryList"
                     AutomationProperties.Name="Filtered alert history"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,9" MinHeight="48">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontWeight="SemiBold"
                                 Text="{Binding StreamId}"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Style="{StaticResource SeverityBadge}" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding Severity}" />
                      </Border>
                      <Border Grid.Column="2" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   Text="{Binding Status}" />
                      </Border>
                      <TextBlock Grid.Column="3"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Text="{Binding Type}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Text="{Binding Message}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="5"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 FontSize="11"
                                 Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyResultsPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
              <TextBlock HorizontalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Text="No matching alerts" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{StaticResource TextMutedBrush}"
                         FontSize="12"
                         Text="Change or clear the filters to broaden the result." />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <StackPanel x:Name="DetailEmptyState"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="Select an alert" />
            <TextBlock Margin="0,6,0,0"
                       MaxWidth="240"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Details and available status actions will appear here." />
          </StackPanel>

          <Grid x:Name="DetailContentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Alert details" />
                <TextBlock x:Name="DetailStreamText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="DetailSeverityText"
                           HorizontalAlignment="Right"
                           Foreground="#FFB8BB"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DetailStatusText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" />
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="TYPE" />
                <TextBlock x:Name="DetailTypeText"
                           Margin="0,0,0,14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="MESSAGE" />
                <Border Margin="0,0,0,14" Style="{StaticResource InsetCard}">
                  <TextBlock x:Name="DetailMessageText"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             TextWrapping="Wrap" />
                </Border>
                <TextBlock Style="{StaticResource FieldLabel}" Text="STARTED" />
                <TextBlock x:Name="DetailStartedText"
                           Margin="0,0,0,14"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="LAST UPDATED" />
                <TextBlock x:Name="DetailUpdatedText"
                           Margin="0,0,0,14"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel x:Name="DetailSnoozedPanel" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SNOOZED UNTIL" />
                  <TextBlock x:Name="DetailSnoozedText"
                             Margin="0,0,0,14"
                             Foreground="#E6B84E" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
              <TextBlock Margin="0,0,0,8"
                         Foreground="{StaticResource TextMutedBrush}"
                         FontSize="11"
                         Text="AVAILABLE ACTIONS" />
              <UniformGrid Columns="2" Rows="2">
                <Button x:Name="AcknowledgeAlertButton"
                        Margin="0,0,6,6"
                        Content="Acknowledge" />
                <Button x:Name="SnoozeAlertButton"
                        Margin="6,0,0,6"
                        Content="Snooze" />
                <Button x:Name="ResolveAlertButton"
                        Margin="0,6,6,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="Resolve" />
                <Button x:Name="IgnoreAlertButton"
                        Margin="6,6,0,0"
                        Style="{StaticResource DangerButton}"
                        Content="Ignore" />
              </UniformGrid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
