<Window x:Class="IPMultiViewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP MultiViewer"
        Width="1360"
        Height="780"
        MinWidth="960"
        MinHeight="600"
        Background="#05080d">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#172033" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="#f8fafc" />
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#334155" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#0b1118" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Foreground="White" FontSize="17" FontWeight="Bold" Margin="14,0,18,0" VerticalAlignment="Center">IP MultiViewer</TextBlock>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
        <ComboBox x:Name="MainLayoutCombo" Width="150" DisplayMemberPath="Name" Margin="0,0,8,0" SelectionChanged="MainLayoutCombo_SelectionChanged" />
        <Button x:Name="StartPlaybackButton" MinWidth="112" Click="StartPlaybackButton_Click">Start</Button>
        <Button x:Name="StopPlaybackButton" MinWidth="76" Click="StopPlaybackButton_Click">Stop</Button>
        <Button x:Name="OpenAlertHistoryButton" MinWidth="104" Click="OpenAlertHistoryButton_Click">Alert History</Button>
        <Button x:Name="OpenSettingsButton" MinWidth="84" Click="OpenSettingsButton_Click">Settings</Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ModeText" Foreground="#d1d5db" VerticalAlignment="Center" />
        <TextBlock Foreground="#465567" Margin="12,0,8,0" VerticalAlignment="Center">|</TextBlock>
        <TextBlock x:Name="PlaybackSummaryText" Foreground="#9ca3af" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <UniformGrid x:Name="TileGrid" Grid.Row="1" Rows="2" Columns="2" Margin="6" />

    <DockPanel Grid.Row="2" Background="#0b1118">
      <TextBlock x:Name="FooterText" Foreground="#7d8998" FontSize="11" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
