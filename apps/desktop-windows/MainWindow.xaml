<Window x:Class="IPMultiViewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IP MultiViewer"
        Width="1640"
        Height="944"
        MinWidth="1320"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource NextAppBackgroundBrush}"
        Foreground="{StaticResource NextTextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Activated="MainWindow_NextActivated"
        Deactivated="MainWindow_NextDeactivated"
        Loaded="MainWindow_NextLoaded"
        LocationChanged="MainWindow_NextLocationChanged"
        SizeChanged="MainWindow_NextSizeChanged"
        StateChanged="MainWindow_NextStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource NextAppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="76" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
      <RowDefinition Height="52" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource NextTitleBarBrush}"
            BorderBrush="{StaticResource NextBorderSoftBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="12,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Image Width="22"
                 Height="22"
                 Margin="0,0,9,0"
                 Source="Assets/AppIcon.ico"
                 Stretch="Uniform" />
          <TextBlock VerticalAlignment="Center"
                     Foreground="{StaticResource NextTextPrimaryBrush}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Text="IP MultiViewer" />
          <TextBlock x:Name="ApplicationVersionText"
                     Margin="10,2,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource NextTextMutedBrush}"
                     FontSize="11"
                     Text="v0.0.0" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}"
                  Click="NextMinimizeButton_Click"
                  ToolTip="Minimize"
                  Content="&#xE921;" />
          <Button Style="{StaticResource CaptionButton}"
                  Click="NextMaximizeButton_Click"
                  ToolTip="Maximize">
            <TextBlock x:Name="NextMaximizeGlyph"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       Text="&#xE922;" />
          </Button>
          <Button Style="{StaticResource CloseCaptionButton}"
                  Click="NextCloseButton_Click"
                  ToolTip="Close"
                  Content="&#xE8BB;" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{StaticResource NextCommandBarBrush}"
            BorderBrush="{StaticResource NextBorderSoftBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="28,0,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="164" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" MinWidth="110" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="148" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="184" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource NextTextPrimaryBrush}"
                   FontSize="25"
                   FontWeight="SemiBold"
                   Text="IP MultiViewer" />

        <Border Grid.Column="1"
                Width="1"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource NextBorderBrush}" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource NextTextMutedBrush}"
                     FontSize="10"
                     Text="MODE" />
          <TextBlock x:Name="ModeText"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource NextTextSecondaryBrush}"
                     FontSize="13"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Column="3"
                Width="1"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource NextBorderBrush}" />

        <Grid Grid.Column="4" Margin="0,0,2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="PlaybackSummaryText"
                     Grid.Column="0"
                     Margin="0,0,16,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource NextTextSecondaryBrush}"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />

          <StackPanel Grid.Column="1"
                      MinWidth="132"
                      VerticalAlignment="Center">
            <TextBlock Foreground="{StaticResource NextTextMutedBrush}"
                       FontSize="10"
                       Text="DECODE / OUTPUT" />
            <TextBlock x:Name="RenderBackendText"
                       Margin="0,4,0,0"
                       Foreground="#F5B942"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="IDLE / —"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="5"
                Width="1"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource NextBorderBrush}" />

        <StackPanel Grid.Column="6" VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource NextTextMutedBrush}"
                     FontSize="10"
                     Text="METER" />
          <Border Height="30"
                  Margin="0,3,0,0"
                  Background="#070E15"
                  BorderBrush="{StaticResource NextBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="NextMeterVuButton"
                      Grid.Column="0"
                      Margin="0"
                      Style="{StaticResource MeterSegmentButton}"
                      Click="NextMeterVuButton_Click"
                      Content="VU" />
              <Button x:Name="NextMeterPeakButton"
                      Grid.Column="1"
                      Margin="0"
                      Style="{StaticResource MeterSegmentButton}"
                      Click="NextMeterPeakButton_Click"
                      Content="PEAK" />
            </Grid>
          </Border>
        </StackPanel>

        <Border Grid.Column="7"
                Width="1"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource NextBorderBrush}" />

        <ComboBox x:Name="MainLayoutCombo"
                  Grid.Column="8"
                  Margin="0"
                  VerticalAlignment="Center"
                  SelectionChanged="MainLayoutCombo_SelectionChanged" />

        <StackPanel Grid.Column="9"
                    Margin="20,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button x:Name="StartPlaybackButton"
                  Width="116"
                  Height="42"
                  Margin="0,0,14,0"
                  Style="{StaticResource PrimaryButton}"
                  Click="StartPlaybackButton_Click"
                  Content="Start" />
          <Button x:Name="StopPlaybackButton"
                  Width="106"
                  Height="42"
                  Margin="0,0,14,0"
                  Style="{StaticResource DangerButton}"
                  Click="StopPlaybackButton_Click"
                  Content="Stop" />
          <Button x:Name="OpenAlertHistoryButton"
                  Width="116"
                  Height="42"
                  Margin="0,0,12,0"
                  Style="{StaticResource CommandButton}"
                  Click="OpenAlertHistoryButton_Click"
                  Content="Alert History" />
          <Button x:Name="OpenSettingsButton"
                  Width="94"
                  Height="42"
                  Margin="0"
                  Style="{StaticResource CommandButton}"
                  Click="OpenSettingsButton_Click"
                  Content="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#0D202B" />

    <Border Grid.Row="3"
            Background="#071019"
            Padding="6,5,6,5">
      <UniformGrid x:Name="TileGrid"
                   Rows="3"
                   Columns="3" />
    </Border>

    <Border Grid.Row="4"
            Background="#08121A"
            BorderBrush="{StaticResource NextBorderSoftBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="15,0,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0"
                 Width="12"
                 Height="12"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"
                 Fill="{StaticResource NextSuccessBrush}" />
        <TextBlock x:Name="FooterText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource NextTextSecondaryBrush}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
