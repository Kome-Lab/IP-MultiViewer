# Copy to /etc/ip-multiviewer/agent.env and replace every placeholder.

MULTIVIEWER_SERVER_URL=https://ip-multiviewer.example.com
MULTIVIEWER_AGENT_CLIENT_ID=agent-01
MULTIVIEWER_AGENT_NAME="IP MultiViewer Agent 01"

# Must match the Server token or one entry from MULTIVIEWER_CLIENT_TOKENS.
MULTIVIEWER_CLIENT_TOKEN=change-this-client-token

MULTIVIEWER_AGENT_INTERVAL_SEC=30
MULTIVIEWER_AGENT_PROBE_TIMEOUT_SEC=5

# Set to true only for smoke checks.
MULTIVIEWER_AGENT_RUN_ONCE=false

# Set to true when this host should only send heartbeat.
MULTIVIEWER_AGENT_DISABLE_PROBING=false
MULTIVIEWER_AGENT_DISABLE_AUTO_RESOLVE=false
