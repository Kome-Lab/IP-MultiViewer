{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ipmv:core:build-evidence-index:1",
  "title": "Unsigned build evidence candidate, never D15-A06 Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_eligible",
    "status",
    "commit",
    "dependency_set_digest",
    "artifacts",
    "reports",
    "provenance_ref",
    "signer_identity",
    "compatibility_approved",
    "security_revision_approved",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "ipmv.core.build-evidence-index.v1"
    },
    "release_eligible": {
      "const": false
    },
    "status": {
      "const": "UNATTESTED_REVIEW_CANDIDATE"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependency_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact_kind",
          "path",
          "sha256",
          "size_bytes",
          "version",
          "go_build_information",
          "compatibility_profile_ref",
          "sbom_refs"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sbom_refs": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "reports": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/ref"
      }
    },
    "provenance_ref": {
      "type": "null"
    },
    "signer_identity": {
      "type": "null"
    },
    "compatibility_approved": {
      "const": false
    },
    "security_revision_approved": {
      "const": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
