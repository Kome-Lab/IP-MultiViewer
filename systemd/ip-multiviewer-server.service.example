[Unit]
Description=ip-multiviewer-server
After=network-online.target

[Service]
User=ip-multiviewer
Group=ip-multiviewer
EnvironmentFile=/etc/ip-multiviewer/server.env
ExecStart=/usr/local/bin/ip-multiviewer-server
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ip-multiviewer
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
