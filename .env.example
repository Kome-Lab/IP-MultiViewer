MULTIVIEWER_BIND_ADDR=127.0.0.1:8080
MULTIVIEWER_PUBLIC_URL=https://multiviewer.example.com
MULTIVIEWER_DATA_DIR=/var/lib/ip-multiviewer
DATABASE_URL=sqlite:///var/lib/ip-multiviewer/ip-multiviewer.db
MULTIVIEWER_ENABLE_AUTH=true
MULTIVIEWER_CLIENT_TOKEN=<YOUR_CLIENT_TOKEN>
MULTIVIEWER_CLIENT_TOKENS=client-01:<CLIENT_01_TOKEN>,client-02:<CLIENT_02_TOKEN>
MULTIVIEWER_CLIENT_OFFLINE_AFTER_SEC=90
MULTIVIEWER_SESSION_SECRET=<CHANGE_ME_64_BYTES>
MULTIVIEWER_SECRET_ENCRYPTION_KEY=change_me_32_byte_secret_value_1
MULTIVIEWER_SERVER_URL=https://multiviewer.example.com
MULTIVIEWER_AGENT_CLIENT_ID=agent-01
MULTIVIEWER_AGENT_NAME=Studio Agent
MULTIVIEWER_AGENT_INTERVAL_SEC=30
MULTIVIEWER_AGENT_PROBE_TIMEOUT_SEC=5
MULTIVIEWER_AGENT_DISABLE_PROBING=false
MULTIVIEWER_AGENT_DISABLE_AUTO_RESOLVE=false
MULTIVIEWER_AGENT_RUN_ONCE=false
TZ=Asia/Tokyo
